~version: "2.1"

# Only individual blog entries, not the blog index or other site pages.
?path: /blog/[^/]+/?
!domain_not: (www\.)?atravkina\.ru

# The page title is generated by Yellow from the page metadata.
title: //head/title
title: //body/article//h1

# Keep the article itself. The Yellow blog layout places previous/next
# navigation links inside the same article element.
body: //body/article
@remove: //body/article/p[a[has-class("previous") or has-class("next")]]

# Optional metadata.
description: //head/meta[@name="description"]/@content
author: //head/meta[@name="author"]/@content
site_name: "Atravkina"
